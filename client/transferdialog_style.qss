/* 
   XiangYueAPP TransferDialog 样式表 (QSS)
   作者: GitHub Copilot
   描述: 文件传输进度对话框，保持与主界面一致的现代化设计
   特性: 蓝紫色渐变背景、玻璃态效果、响应式交互
*/

/* ============================================
   对话框样式
   ============================================ */
TransferDialog {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0 #667eea,
        stop:1 #764ba2
    );
}

/* ============================================
   中心部件样式
   ============================================ */
TransferDialog QWidget {
    background: transparent;
}

/* ============================================
   标签样式（文件名、速度、时间等文本）
   ============================================ */
TransferDialog QLabel {
    color: white;
    font-size: 12px;
    background: transparent;
}

/* ============================================
   进度条样式
   ============================================ */
TransferDialog QProgressBar {
    background: rgba(255, 255, 255, 0.15);
    border: none;
    border-radius: 6px;
    padding: 2px;
    text-align: center;
    color: white;
    height: 24px;
}

TransferDialog QProgressBar::chunk {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #FFD89B,
        stop:1 #FF7043
    );
    border-radius: 4px;
}

/* ============================================
   按钮样式（暂停/继续/取消）
   ============================================ */
TransferDialog QPushButton {
    background: rgba(255, 255, 255, 0.15);
    color: white;
    border: none;
    border-radius: 6px;
    padding: 8px 20px;
    font-size: 12px;
    font-weight: 500;
    outline: none;
}

TransferDialog QPushButton:hover {
    background: rgba(255, 255, 255, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.3);
}

TransferDialog QPushButton:pressed {
    background: rgba(255, 255, 255, 0.35);
}

/* 取消按钮特殊样式 */
TransferDialog QPushButton#buttonCancel {
    background: rgba(255, 107, 53, 0.3);
}

TransferDialog QPushButton#buttonCancel:hover {
    background: rgba(255, 107, 53, 0.4);
}

TransferDialog QPushButton#buttonCancel:pressed {
    background: rgba(255, 107, 53, 0.5);
}

/* ============================================
   分组框样式
   ============================================ */
TransferDialog QGroupBox {
    color: white;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 6px;
    padding-top: 10px;
    margin-top: 6px;
}

TransferDialog QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 3px 0 3px;
    color: white;
}
