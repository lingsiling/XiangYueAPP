/* 
   XiangYueAPP ResourceDetailDialog 样式表 (QSS)
   作者: GitHub Copilot
   描述: 资源详情对话框，保持与主界面一致的现代化设计
   特性: 蓝紫色渐变背景、玻璃态效果、响应式交互
*/

/* ============================================
   对话框样式
   ============================================ */
ResourceDetailDialog {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0 #667eea,
        stop:1 #764ba2
    );
}

/* ============================================
   中心部件样式
   ============================================ */
/* 只让 QFrame 透明，不影响 QMessageBox 等弹窗 */
ResourceDetailDialog QFrame {
    background: transparent;
}

/* 标题标签（单独指定，不影响 QMessageBox） */
ResourceDetailDialog QLabel#labelSessionTitle,
ResourceDetailDialog QLabel#labelUploader,
ResourceDetailDialog QLabel#labelUploadTime,
ResourceDetailDialog QLabel#labelDescTitle,
ResourceDetailDialog QLabel#labelFilesTitle,
ResourceDetailDialog QLabel#labelCommentsTitle {
    color: white;
    font-size: 12px;
    background: transparent;
}

/* 主要操作按钮：暖橙渐变 */
ResourceDetailDialog QPushButton#buttonDownloadAll,
ResourceDetailDialog QPushButton#buttonFavorite,
ResourceDetailDialog QPushButton#buttonComment {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0 #FFD89B,
        stop:1 #FF7043
    );
    color: white;
    border: none;
    border-radius: 6px;
    padding: 10px 25px;
    font-size: 12px;
    font-weight: bold;
    outline: none;
}

ResourceDetailDialog QPushButton#buttonDownloadAll:hover,
ResourceDetailDialog QPushButton#buttonFavorite:hover,
ResourceDetailDialog QPushButton#buttonComment:hover {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0 #FFE5B4,
        stop:1 #FF8A50
    );
}

ResourceDetailDialog QPushButton#buttonDownloadAll:pressed,
ResourceDetailDialog QPushButton#buttonFavorite:pressed,
ResourceDetailDialog QPushButton#buttonComment:pressed {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0 #FFC466,
        stop:1 #FF6B35
    );
}

/* 预览按钮：次要操作，采用与项目其它界面（上传资源 btnPreview / 我的上传）
   一致的玻璃白外观，区别于上面的暖橙主操作按钮 */
ResourceDetailDialog QPushButton#buttonPreview {
    background: rgba(255, 255, 255, 0.15);
    color: white;
    border: none;
    border-radius: 6px;
    padding: 10px 25px;
    font-size: 12px;
    font-weight: 500;
    outline: none;
}

ResourceDetailDialog QPushButton#buttonPreview:hover {
    background: rgba(255, 255, 255, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.3);
}

ResourceDetailDialog QPushButton#buttonPreview:pressed {
    background: rgba(255, 255, 255, 0.35);
}

/* ============================================
   文本编辑框样式（评论输入）
   ============================================ */
ResourceDetailDialog QTextEdit {
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 6px;
    padding: 10px;
    color: white;
    font-size: 12px;
}

ResourceDetailDialog QTextEdit:focus {
    background: rgba(255, 255, 255, 0.18);
    border: 1px solid rgba(255, 255, 255, 0.4);
}

/* ============================================
   列表/树组件样式
   ============================================ */
ResourceDetailDialog QListWidget,
ResourceDetailDialog QTreeWidget {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 6px;
    outline: none;
    color: white;
}

/* item 不设逐格 border、并关闭 outline：
   多列 QTreeWidget 若给 item 加 border，会在每个单元格四周各画一圈，
   点击时看起来就是一圈圈黑框；选中只改背景即可保证整行高亮连成一块。 */
ResourceDetailDialog QListWidget::item,
ResourceDetailDialog QTreeWidget::item {
    border: none;
    outline: none;
}

ResourceDetailDialog QListWidget::item:hover,
ResourceDetailDialog QTreeWidget::item:hover {
    background: rgba(255, 255, 255, 0.15);
}

ResourceDetailDialog QListWidget::item:selected,
ResourceDetailDialog QTreeWidget::item:selected {
    background: rgba(255, 216, 155, 0.3);
    border: none;
}

/* ============================================
   标签流式列表样式（listWidgetTags）
   与上传资源详情界面风格统一：暖金色半透明椭圆背景
   ============================================ */
ResourceDetailDialog QListWidget#listWidgetTags {
    background: transparent;              /* 外层无背景 */
    border: none;
    outline: none;
}

ResourceDetailDialog QListWidget#listWidgetTags::item {
    background: rgba(255, 216, 155, 0.20);    /* 暖金色半透明底 */
    color: #FFD89B;                            /* 暖金色文字 */
    border-radius: 8px;                        /* 圆角椭圆 */
    padding: 3px 10px;
}

/* ============================================
   评论列表聊天气泡样式（listWidgetComments）
   纯透明背景 + 无选中高亮，每条评论像 QQ 气泡一样独立浮在透明区域上
   ============================================ */
ResourceDetailDialog QListWidget#listWidgetComments {
    background: transparent;
    border: none;
    outline: none;
}

ResourceDetailDialog QListWidget#listWidgetComments::item {
    background: transparent;            /* 整行无背景 */
    color: white;
    padding: 4px 0px;
    border: none;
}

ResourceDetailDialog QListWidget#listWidgetComments::item:hover,
ResourceDetailDialog QListWidget#listWidgetComments::item:selected {
    background: transparent;            /* 去除点击/悬停变色 */
    color: white;
    border: none;
}

/* ============================================
   滚动条样式
   ============================================ */
ResourceDetailDialog QScrollBar:vertical {
    background: rgba(255, 255, 255, 0.1);
    width: 8px;
    border-radius: 4px;
}

ResourceDetailDialog QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 0.3);
    border-radius: 4px;
}

ResourceDetailDialog QScrollBar::handle:vertical:hover {
    background: rgba(255, 255, 255, 0.4);
}
